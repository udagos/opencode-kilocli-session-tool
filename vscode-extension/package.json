{
  "name": "osm-vscode",
  "displayName": "OpenCode Session Manager",
  "description": "Manage and resume OpenCode and Kilo sessions from VSCode",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "osm.refresh",
        "title": "Refresh OSM Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "osm.searchSessions",
        "title": "Search Sessions",
        "icon": "$(search)"
      },
      {
        "command": "osm.clearSearch",
        "title": "Clear Search",
        "icon": "$(clear-all)"
      },
      {
        "command": "osm.setSort",
        "title": "Set Sorting Options",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "osm.resumeSession",
        "title": "Resume Session",
        "icon": "$(play)"
      },
      {
        "command": "osm.viewSessionContent",
        "title": "View Session Content",
        "icon": "$(preview)"
      },
      {
        "command": "osm.deleteSession",
        "title": "Delete Session",
        "icon": "$(trash)"
      },
      {
        "command": "osm.togglePin",
        "title": "Toggle Pin",
        "icon": "$(pin)"
      },
      {
        "command": "osm.setNote",
        "title": "Add/Edit Note"
      },
      {
        "command": "osm.addLabel",
        "title": "Add Label",
        "icon": "$(tag)"
      },
      {
        "command": "osm.removeLabel",
        "title": "Remove Label"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "osm-explorer",
          "title": "OSM Sessions",
          "icon": "$(list-tree)"
        }
      ]
    },
    "views": {
      "osm-explorer": [
        {
          "id": "osm.sessionsView",
          "name": "Sessions"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "osm.searchSessions",
          "when": "view == osm.sessionsView",
          "group": "navigation@1"
        },
        {
          "command": "osm.clearSearch",
          "when": "view == osm.sessionsView && osm.searchActive",
          "group": "navigation@2"
        },
        {
          "command": "osm.setSort",
          "when": "view == osm.sessionsView",
          "group": "navigation@3"
        },
        {
          "command": "osm.refresh",
          "when": "view == osm.sessionsView",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "osm.resumeSession",
          "when": "view == osm.sessionsView && viewItem =~ /session/",
          "group": "inline@1"
        },
        {
          "command": "osm.viewSessionContent",
          "when": "view == osm.sessionsView && viewItem =~ /session/",
          "group": "inline@2"
        },
        {
          "command": "osm.togglePin",
          "when": "view == osm.sessionsView && viewItem =~ /session/",
          "group": "inline@3"
        },
        {
          "command": "osm.addLabel",
          "when": "view == osm.sessionsView && viewItem =~ /session/",
          "group": "inline@4"
        },
        {
          "command": "osm.deleteSession",
          "when": "view == osm.sessionsView && viewItem =~ /session/",
          "group": "inline@5"
        },
        {
          "command": "osm.setNote",
          "when": "view == osm.sessionsView && viewItem =~ /session/",
          "group": "modification@1"
        },
        {
          "command": "osm.removeLabel",
          "when": "view == osm.sessionsView && viewItem =~ /session/",
          "group": "modification@2"
        }
      ]
    },
    "configuration": {
      "title": "OSM",
      "properties": {
        "osm.backend": {
          "type": "string",
          "enum": [
            "opencode",
            "kilo"
          ],
          "default": "kilo",
          "description": "The backend to use for OSM (opencode or kilo)"
        },
        "osm.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to the python executable (e.g., 'python', 'python3', or absolute path)"
        },
        "osm.scriptPath": {
          "type": "string",
          "default": "osm",
          "description": "Path or command to run osm. If installed globally via uv/pip, just 'osm' works. If local, provide the full path to osm.py."
        },
        "osm.sortBy": {
          "type": "string",
          "enum": ["time_updated", "time_created", "title"],
          "default": "time_updated",
          "description": "Default sorting field for sessions"
        },
        "osm.sortOrder": {
          "type": "string",
          "enum": ["DESC", "ASC"],
          "default": "DESC",
          "description": "Default sorting order for sessions"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}
